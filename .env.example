# Demoblaze credentials
# Create a free account at https://www.demoblaze.com and fill these in.
DEMOBLAZE_USERNAME=your_demoblaze_username
DEMOBLAZE_PASSWORD=your_demoblaze_password

# RESTful Booker base URL
RESTFUL_BOOKER_BASE_URL=https://restful-booker.herokuapp.com

# Environment: staging or production
# Both currently point to Demoblaze; configured for multi-environment support.
NODE_ENV=staging
